    {
      "type": "comparison",
      "eyebrow": "Eyebrow",
      "heading": "From the old way to the new way.",
      "lead": "What changed and why.",
      "a": {
        "eyebrow": "Before",
        "heading": "Old approach",
        "body": "What it did and where it fell short.",
        "media": { "src": "/images/project-slug/before.png", "alt": "" }
      },
      "b": {
        "eyebrow": "After",
        "heading": "New approach",
        "body": "What it does now.",
        "media": { "src": "/images/project-slug/after.png", "alt": "" }
      }
    },

    {
      "type": "steps",
      "_note": "Only for real sequences (process, method, timeline).",
      "eyebrow": "How it works",
