{
  "_readme": "Template for one project. Files starting with _ are ignored by the site. Copy this file, rename it to <slug>.json, delete sections you don't need, reorder freely. Every field except section 'type' is optional. Keys starting with _ are notes and are ignored by the renderer. Image paths are relative to /public.",

  "slug": "project-slug",
  "title": "Project Title",
  "order": 1,
  "categories": ["Project Management", "User Research", "UX/UI Design", "Front-End Development"],

  "card": {
    "_note": "Shown on the homepage card when this project is active in the list.",
    "shortName": "Short name",
    "icon": "/images/project-slug/icon.svg",
    "logo": { "src": "/images/project-slug/logo.png", "alt": "Organization name" },
    "_logo_note": "Optional. A wide logo image shown instead of the icon and short name. Trim extra whitespace around it.",
    "summary": "Two to four sentences. What the project is and the main outcome.",
    "tags": ["Product Management", "Information Management"],
    "image": { "src": "/images/project-slug/card.jpg", "alt": "Describe the image" }
  },

  "sections": [
    {
      "type": "intro",
      "_note": "Always first. Top of the modal (reference 02).",
      "banner": { "src": "/images/project-slug/banner.jpg", "alt": "" },
      "title": "Modal title in italic",
      "summary": "One paragraph summary.",
      "meta": [
        { "label": "Role", "value": "Who did what" },
        { "label": "Stage", "value": "Research / Prototype / Shipped" },
        { "label": "Platform", "value": "Web / iOS / Physical" },
        { "label": "Focus", "value": "One-line focus" }
      ],
      "image": { "src": "/images/project-slug/intro.jpg", "alt": "" }
    },

    {
      "type": "overview",
      "eyebrow": "Overview",
      "heading": "Big statement heading.",
      "lead": "Lead paragraph that frames the project.",
      "pillars": [
        { "title": "Pillar one", "text": "One line." },
        { "title": "Pillar two", "text": "One line." },
        { "title": "Pillar three", "text": "One line." }
      ]
    },

    {
      "type": "feature",
      "_note": "Repeat for each key finding, feature or deliverable. 'side' = where the media goes: 'left' | 'right'. Omit to auto-alternate.",
      "number": "01",
      "label": "Label",
      "heading": "Italic feature heading.",
      "body": "One or two short paragraphs. Separate paragraphs with \\n\\n.",
      "bullets": ["Point one", "Point two", "Point three"],
      "note": "Optional small pill note",
      "media": [
        { "src": "/images/project-slug/feature-1.png", "alt": "", "frame": "phone" }
      ],
      "_media_frame_options": "phone | browser | none. 'phone' and 'browser' add a device frame. Up to 2 media items.",
